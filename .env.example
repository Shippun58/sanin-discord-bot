# Paste your Discord Bot Token below (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here
# Comma-separated Groq keys, failover order
GROQ_API_KEYS=
# Optional Gemini fallback key
GEMINI_API_KEY=
# TMDB v3 API key (enables movie/TV release data)
TMDB_API_KEY=
# GitHub token used to store /learn facts in the memory branch
GH_TOKEN=
# Repo and branch used for learned facts
MEMORY_REPO=Shippun58/sanin-discord-bot
MEMORY_BRANCH=memory
# Discord user ID allowed to use /learn and /forget (optional; bot owner auto-detected)
OWNER_ID=
# Discord user ID to ping when San can't help
DEV_ID=
# Channel ID for moderation case logs (optional)
MODLOG_CHANNEL_ID=
# Health-check server port
PORT=10000
